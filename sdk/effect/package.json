{
  "name": "@polar-sh/effect",
  "version": "0.0.0",
  "description": "Polar SDK for Effect — A billing platform for the intelligence era",
  "keywords": [
    "api",
    "effect",
    "polar",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "author": "Polar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polarsource/polar.git",
    "directory": "sdk/effect"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./2026-10": {
      "import": {
        "types": "./dist/2026-10/index.d.mts",
        "default": "./dist/2026-10/index.mjs"
      },
      "require": {
        "types": "./dist/2026-10/index.d.cts",
        "default": "./dist/2026-10/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "effect": "4.0.0-rc.114",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.114"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.1"
}
